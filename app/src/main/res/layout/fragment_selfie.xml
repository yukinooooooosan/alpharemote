<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/selfie_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#182018" android:fillViewport="true" android:theme="@style/ThemeOverlay.Selfie">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/selfie_camera_label" android:textSize="20sp" android:textColor="#F4F5EC" />
            <TextView android:id="@+id/connection_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="@string/selfie_offline" android:textColor="#ADB7A5" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/camera_settings" style="@style/Widget.MaterialComponents.Button.TextButton.Icon" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp" android:contentDescription="@string/selfie_settings" app:icon="@drawable/ic_settings_black_24dp" app:iconGravity="textStart" app:iconPadding="0dp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/selfie_title" android:letterSpacing="0.25" android:textColor="#DBF79B" android:gravity="center" android:textSize="14sp" />
        <TextView android:id="@+id/phase_display" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="128dp" android:gravity="center" android:textColor="#F4F5EC" android:textSize="72sp" android:fontFamily="sans-serif-light" android:layout_marginTop="12dp" />
        <TextView android:id="@+id/phase_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/selfie_ready" android:textSize="14sp" android:textColor="#ADB7A5" />
        <TextView android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="#DBF79B" android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/start_stop" android:layout_width="match_parent" android:layout_height="88dp" android:layout_marginTop="24dp" android:text="@string/selfie_start" android:textSize="24sp" android:letterSpacing="0.12" app:cornerRadius="28dp" app:backgroundTint="#DBF79B" android:textColor="#182018" />
        <LinearLayout android:id="@+id/options" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/selfie_delay" android:textColor="#ADB7A5" android:textSize="13sp" />
<com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/countdown_choices" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true"><com.google.android.material.button.MaterialButton android:id="@+id/delay_3" style="@style/Widget.Selfie.Choice" android:text="@string/selfie_seconds_3" />
<com.google.android.material.button.MaterialButton android:id="@+id/delay_5" style="@style/Widget.Selfie.Choice" android:text="@string/selfie_seconds_5" />
<com.google.android.material.button.MaterialButton android:id="@+id/delay_10" style="@style/Widget.Selfie.Choice" android:text="@string/selfie_seconds_10" />
</com.google.android.material.button.MaterialButtonToggleGroup>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/selfie_capture" android:textColor="#ADB7A5" android:textSize="13sp" />
<com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/hold_choices" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true"><com.google.android.material.button.MaterialButton android:id="@+id/hold_single" style="@style/Widget.Selfie.Choice" android:text="@string/selfie_single" />
<com.google.android.material.button.MaterialButton android:id="@+id/hold_half" style="@style/Widget.Selfie.Choice" android:text="@string/selfie_hold_half" />
<com.google.android.material.button.MaterialButton android:id="@+id/hold_one" style="@style/Widget.Selfie.Choice" android:text="@string/selfie_hold_one" />
<com.google.android.material.button.MaterialButton android:id="@+id/hold_two" style="@style/Widget.Selfie.Choice" android:text="@string/selfie_hold_two" />
</com.google.android.material.button.MaterialButtonToggleGroup>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/selfie_cycles" android:textColor="#ADB7A5" android:textSize="13sp" />
<com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/cycle_choices" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true"><com.google.android.material.button.MaterialButton android:id="@+id/cycles_one" style="@style/Widget.Selfie.Choice" android:text="@string/selfie_cycles_one" />
<com.google.android.material.button.MaterialButton android:id="@+id/cycles_five" style="@style/Widget.Selfie.Choice" android:text="@string/selfie_cycles_five" />
<com.google.android.material.button.MaterialButton android:id="@+id/cycles_ten" style="@style/Widget.Selfie.Choice" android:text="@string/selfie_cycles_ten" />
<com.google.android.material.button.MaterialButton android:id="@+id/cycles_infinite" style="@style/Widget.Selfie.Choice" android:text="@string/selfie_infinite" />
</com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/countdown_sound" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="@string/selfie_sound" android:textSize="14sp" android:textColor="#F4F5EC" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/selfie_drive_hint" android:textSize="12sp" android:textColor="#ADB7A5" android:lineSpacingExtra="3dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/selfie_sound_hint" android:textSize="12sp" android:textColor="#ADB7A5" android:lineSpacingExtra="3dp" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>